---
import { getEntry } from "astro:content";
import Head from "@/components/base/Head.astro";
import Link from "@/components/base/Link.astro";
import DirectoryProfile from "@/components/nav/DirectoryProfile.astro";
import ResumeText from "@/components/resume/ResumeText.astro";
import { siteConfig } from "@/site.config";
import { getResumeUpdatedDate } from "@/utils/resumeUpdated";
import "@/styles/main.css";

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const resume = entry.data;
const updatedDate = getResumeUpdatedDate();
const updatedLabel = new Intl.DateTimeFormat(siteConfig.lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
}).format(updatedDate);
const rowClass = "flex justify-between gap-4 max-[600px]:flex-wrap max-[600px]:gap-x-3 max-[600px]:gap-y-0";
const rowEndClass = "text-right shrink-0 max-[600px]:text-left max-[600px]:shrink";
const sectionClass = "mt-[10px] max-[600px]:mt-4";
const headingClass = "text-base font-700 uppercase border-b border-current mb-[3px]";
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <Head title={resume.title} description={resume.description} />
  </head>
  <body class="color-portfolio-ink font-sans bg-portfolio-base antialiased">
    <a href="#main-content" class="skip-link focus-ring-link p-3 bg-portfolio-base left-0 top-0 fixed z-50 print:hidden">Skip to resume</a>
    <div class="mx-auto px-[18px] py-12 gap-10 grid max-w-[1152px] print:p-0 lg:gap-[18px] lg:grid-cols-[224px_minmax(0,1fr)] print:block">
      <aside class="flex flex-col gap-8 self-start justify-between lg:min-h-[calc(100svh-96px)] print:hidden lg:top-12 lg:sticky" aria-label="Profile">
        <DirectoryProfile />
        <div>
          <Link href="/docs/resume.pdf" download="Julian-Peter-Gerona-Resume.pdf" class="text-sm color-portfolio-muted decoration-current underline-offset-4 hover:color-portfolio-ink underline! decoration-dashed!">Download PDF</Link>
          <p class="text-xs color-portfolio-muted mt-3">Updated <time datetime={updatedDate.toISOString()}>{updatedLabel}</time></p>
        </div>
      </aside>

      <main id="main-content" class="text-[15px] leading-[1.14] font-resume min-w-0 [font-variant-ligatures:none] max-[600px]:text-base max-[600px]:leading-[1.3]" tabindex="-1">
        <header class="mb-[18px] text-center">
          <h1 class="text-2xl font-700 uppercase">{resume.name}</h1>
          <address class="text-[13px] mt-0.5 not-italic max-[600px]:flex max-[600px]:flex-wrap max-[600px]:gap-x-3 max-[600px]:gap-y-0.5 max-[600px]:justify-center">
            {resume.contact.map((contact, index) => (
              <>
                {index > 0 && <span class="whitespace-pre max-[600px]:hidden" aria-hidden="true"> | </span>}
                <span class="max-[600px]:inline-block max-[600px]:[overflow-wrap:anywhere]">{contact.href ? <a href={contact.href} class="color-inherit no-underline hover:underline">{contact.text}</a> : contact.text}</span>
              </>
            ))}
          </address>
        </header>

        <section aria-labelledby="education">
          <h2 id="education" class={headingClass}>Education</h2>
          {resume.education.map((item, index) => (
            <div class:list={[index > 0 && "mt-[9px]"]}>
              <div class={rowClass}><h3 class="font-700">{item.institution}</h3><strong class={rowEndClass}>{item.location}</strong></div>
              <div class={rowClass}><p>{item.credential}</p><p class={rowEndClass}>{item.period}</p></div>
              <div class="pl-5">{item.details.map(detail => <p><ResumeText text={detail} /></p>)}</div>
            </div>
          ))}
        </section>

        <section aria-labelledby="experience" class={sectionClass}>
          <h2 id="experience" class={headingClass}>Work Experience</h2>
          {resume.experience.map((item, index) => (
            <div class:list={[index > 0 && "mt-[9px]"]}>
              <div class={rowClass}><h3 class="font-700">{item.organization}</h3><strong class={rowEndClass}>{item.location}</strong></div>
              <div class={rowClass}><p>{item.role}</p><p class={rowEndClass}>{item.period}</p></div>
              <ul class="pl-5 list-disc">{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="projects" class={sectionClass}>
          <h2 id="projects" class={headingClass}>Projects</h2>
          {resume.projects.map((item, index) => (
            <div class:list={[index > 0 && "mt-[9px]"]}>
              <div class={rowClass}><h3 class="font-700">{item.name}</h3><strong class={rowEndClass}>{item.year}</strong></div>
              <ul class="pl-5 list-disc">{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="affiliations" class={sectionClass}>
          <h2 id="affiliations" class={headingClass}>Affiliations</h2>
          {resume.affiliations.map((item, index) => (
            <div class:list={[index > 0 && "mt-[9px]"]}>
              <div class={rowClass}><h3 class="font-700">{item.organization}</h3><strong class={rowEndClass}>{item.period}</strong></div>
              <ul class="pl-5 list-disc">{item.highlights.map(highlight => <li><ResumeText text={highlight} /></li>)}</ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="skills" class={sectionClass}>
          <h2 id="skills" class={headingClass}>Skills</h2>
          {resume.skills.map(skill => <p class="indent-[-20px] pl-5"><strong>{skill.category}:</strong> {skill.text}</p>)}
        </section>
      </main>
    </div>
  </body>
</html>
