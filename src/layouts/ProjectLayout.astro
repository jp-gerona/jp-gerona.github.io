---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, stack, repo, link, pubDate, updatedDate, ogImage } = project.data;

const dateFormat = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long" });
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="section-container px-6 py-20 md:px-10">
    <div class="mx-auto flex flex-col gap-10 max-w-3xl">
      <header class="flex flex-col gap-4">
        <h1 class="text-3xl leading-[1.1] tracking-[-0.02em] uppercase md:text-5xl">
          {title}
        </h1>
        {description && <p class="text-lg">{description}</p>}
        {stack.length > 0 && (
          <ul class="text-sm flex flex-wrap gap-2">
            {stack.map(item => <li>{item}</li>)}
          </ul>
        )}
        <div class="text-sm flex flex-wrap gap-4">
          {pubDate && <time datetime={pubDate.toISOString()}>{dateFormat.format(pubDate)}</time>}
          {updatedDate && (
            <time datetime={updatedDate.toISOString()}>
              Updated {dateFormat.format(updatedDate)}
            </time>
          )}
          {repo && <a class="focus-ring-link" href={repo}>Repository</a>}
          {link && <a class="focus-ring-link" href={link}>Live</a>}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
