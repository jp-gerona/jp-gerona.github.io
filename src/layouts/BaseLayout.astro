---
import type { MarkdownHeading } from "astro";
import Footer from "@/components/base/Footer.astro";
import Head from "@/components/base/Head.astro";
import PageProgress from "@/components/base/PageProgress.astro";
import SideNav from "@/components/nav/SideNav.astro";
import { siteConfig } from "@/site.config";

import "@/styles/main.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | boolean;
  headings?: MarkdownHeading[];
}

const { title, description, ogImage, headings } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <Head title={title} description={description} ogImage={ogImage} />
  </head>
  <body class="color-portfolio-ink bg-portfolio-base antialiased">
    <PageProgress />
    <a class="focus-ring-link sr-only focus:not-sr-only" href="#main-content">Skip to main content</a>
    <div class="bg-portfolio-base relative z-10">
      <div class="mx-auto px-4.5 pb-40 pt-12 gap-4.5 max-w-6xl lg:grid lg:grid-cols-[14rem_1fr]">
        <SideNav headings={headings} />
        <main id="main-content" class="min-h-svh">
          <slot />
        </main>
      </div>
    </div>
    <Footer />

    <script>
      import { initSmoothScroll } from "@/utils/smoothScroll";

      document.addEventListener("astro:page-load", initSmoothScroll);
    </script>
  </body>
</html>
