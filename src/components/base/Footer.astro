---
import AsciiGarden from "@/components/garden/AsciiGarden.astro";

import { siteConfig } from "@/site.config";
import Link from "./Link.astro";

function normalizePath(pathname: string): string {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePath(Astro.url.pathname);
const navItems = siteConfig.navigation.main;
const licenseText = "CC BY-NC-SA 4.0";
const [copyrightPrefix, copyrightSuffix] = siteConfig.footer.copyright.split(
  licenseText,
);

const footerSections = [
  { label: "Portfolio", items: navItems },
  ...siteConfig.footer.sections,
];

const currentYear = new Date().getFullYear();
---

<footer class="px-8 pt-10 bg-gruvbox-bg0 flex flex-col h-[calc(100svh-57px)] overflow-hidden">
  <div class="flex-1 gap-x-4 gap-y-8 grid grid-cols-[auto_1fr] grid-rows-[auto_auto_auto_minmax(0,1fr)] items-start justify-items-start md:gap-y-10 md:grid-cols-[auto_repeat(3,auto)] md:grid-rows-[auto_1fr]">

    <div class="flex flex-col gap-2 col-span-2 md:col-span-1">
      <p class="text-[1.25em] color-gruvbox-fg0 font-serif font-italic md:text-[1.5em]">{siteConfig.footer.quote}</p>
      <p class="text-[0.7em] color-gruvbox-fg0 font-mono uppercase">
        {copyrightPrefix}
        <Link
          class="decoration-current underline-offset-4 underline! decoration-dashed!"
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          title="Creative Commons BY-NC-SA 4.0 License"
          external
        >
          {licenseText}
        </Link>
        {copyrightSuffix} — {currentYear}
      </p>
    </div>
    {
      footerSections.map(section => (
        <ul class="flex flex-col gap-2">
          <li>
            <p class="text-[0.7em] color-gruvbox-fg1 leading-relaxed tracking-tight font-mono shrink-0 uppercase">{section.label}</p>
          </li>
          {section.items.map((item) => {
            const isInternal = item.href.startsWith("/");
            const isCurrent = isInternal && normalizePath(item.href) === currentPathname;
            return (
              <li>
                <Link
                  class="text-[0.7em] color-fg0 leading-none tracking-tight font-mono shrink-0 uppercase"
                  href={item.href}
                  title={item.title ?? item.label}
                  external={item.external}
                  rel={item.rel}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {item.label}
                </Link>
              </li>
            );
          })}
        </ul>
      ))
    }
    <AsciiGarden />
  </div>
</footer>
