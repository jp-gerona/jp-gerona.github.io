---
import { siteConfig } from "@/site.config";

import AsciiWordmark from "./AsciiWordmark.astro";
import Link from "./Link.astro";
import SkyBackground from "./SkyBackground.astro";

function normalizePath(pathname: string): string {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePath(Astro.url.pathname);
const navItems = siteConfig.navigation.main;
const licenseText = "CC BY-NC-SA 4.0";
const [copyrightPrefix, copyrightSuffix] = siteConfig.footer.copyright.split(
  licenseText,
);

const footerSections = [
  { label: "Portfolio", items: navItems },
  ...siteConfig.footer.sections,
];

const currentYear = new Date().getFullYear();
const skyTheme = siteConfig.footer.theme === "sky";
const textColor = skyTheme ? "color-white" : "color-gruvbox-fg0";
const linkColor = skyTheme ? "color-white" : "color-gruvbox-gray-h";
---

<footer data-theme={siteConfig.footer.theme} class:list={["px-6 pb-6 pt-10 flex flex-col gap-10 min-h-[calc(100svh-57px)] bottom-0 sticky z-0 md:px-8", skyTheme ? "isolate bg-[#205a96]" : "bg-gruvbox-bg0"]}>
  {skyTheme && <SkyBackground />}
  <AsciiWordmark class={[textColor, skyTheme && "relative z-1"].filter(Boolean).join(" ")} />
  <div class:list={["gap-x-4 gap-y-8 grid grid-cols-2 items-start md:grid-cols-3", skyTheme && "relative z-1"]}>
    {
      footerSections.map(section => (
        <ul class="flex flex-col gap-2">
          <li>
            <p class:list={["text-[0.7em] leading-relaxed tracking-tight font-mono shrink-0 uppercase", textColor]}>{section.label}</p>
          </li>
          {section.items.map((item) => {
            const isInternal = item.href.startsWith("/");
            const isCurrent = isInternal && normalizePath(item.href) === currentPathname;
            return (
              <li>
                <Link
                  class:list={["text-[0.7em] leading-none tracking-tight font-mono shrink-0 uppercase", linkColor]}
                  href={item.href}
                  title={item.title ?? item.label}
                  external={item.external}
                  rel={item.rel}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {item.label}
                </Link>
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
  <p class:list={["text-[0.7em] font-mono uppercase", textColor, skyTheme && "relative z-1"]}>
    {copyrightPrefix}
    <Link
      class="decoration-current underline-offset-4 underline! decoration-dashed!"
      href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
      title="Creative Commons BY-NC-SA 4.0 License"
      external
    >
      {licenseText}
    </Link>
    {copyrightSuffix} · {currentYear}
  </p>
</footer>
