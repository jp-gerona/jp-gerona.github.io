---
import { siteConfig } from "@/site.config";

interface Props {
  class?: string;
}

const { class: className = "color-gruvbox-fg0" } = Astro.props;
---

<div data-ascii-wordmark data-wordmark-text={siteConfig.user} class:list={["relative flex flex-1 flex-col min-h-[clamp(18rem,48svh,36rem)]", className]}>
  <button
    type="button"
    class="focus-ring-core color-inherit p-0 border-0 rounded-0 bg-transparent flex-1 min-h-0 w-full cursor-pointer relative touch-pan-y touch-pinch-zoom disabled:cursor-default"
    aria-label={`ASCII wordmark: ${siteConfig.user}`}
    disabled
  >
    <noscript>
      <span class="text-[48vw] leading-none font-400 font-mono flex h-full items-center justify-center md:text-[min(15vw,16rem)]" aria-hidden="true">
        <span class="hidden md:inline">{siteConfig.user}</span>
        <span class="md:hidden">jp</span>
      </span>
    </noscript>
    <canvas class="opacity-0 h-full w-full inset-0 absolute" aria-hidden="true"></canvas>
  </button>
</div>

<script>
  import { destroyAsciiWordmarks, initializeAsciiWordmarks } from "./asciiWordmark";

  initializeAsciiWordmarks();
  document.addEventListener("astro:page-load", initializeAsciiWordmarks);
  document.addEventListener("astro:before-swap", destroyAsciiWordmarks);
</script>
