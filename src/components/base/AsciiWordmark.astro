---
import { siteConfig } from "@/site.config";
---

<div data-ascii-wordmark data-wordmark-text={siteConfig.user} class="ascii-wordmark color-gruvbox-fg0">
  <button
    type="button"
    class="ascii-wordmark-button focus-ring-core"
    aria-label={`ASCII wordmark: ${siteConfig.user}`}
    disabled
  >
    <span class="ascii-wordmark-fallback" aria-hidden="true">
      <span class="hidden md:inline">{siteConfig.user}</span>
      <span class="md:hidden">jp</span>
    </span>
    <canvas class="ascii-wordmark-canvas" aria-hidden="true"></canvas>
  </button>
</div>

<script>
  import { destroyAsciiWordmarks, initializeAsciiWordmarks } from "./asciiWordmark";

  initializeAsciiWordmarks();
  document.addEventListener("astro:page-load", initializeAsciiWordmarks);
  document.addEventListener("astro:before-swap", destroyAsciiWordmarks);
</script>

<style>
  .ascii-wordmark {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: clamp(18rem, 48svh, 36rem);
  }

  .ascii-wordmark-button {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    touch-action: pan-y pinch-zoom;
  }

  .ascii-wordmark-button:disabled {
    cursor: default;
  }

  .ascii-wordmark-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-family: "IBM Plex Mono", monospace;
    font-size: 48vw;
    font-weight: 700;
    line-height: 1;
  }

  .ascii-wordmark-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    image-rendering: auto;
  }

  [data-wordmark-ready] .ascii-wordmark-fallback {
    visibility: hidden;
  }

  [data-wordmark-ready] .ascii-wordmark-canvas {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .ascii-wordmark-fallback {
      font-size: min(15vw, 16rem);
    }
  }
</style>
