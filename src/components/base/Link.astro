---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href?: string;
  title?: string;
  rel?: string;
  external?: boolean;
  class?: string;
  umami?: string;
}

// todo: probably add bool enableNewTabWarning and add as additional flag to showCursor and showIcon
const {
  href,
  title,
  rel,
  external = false,
  class: className,
  umami,
  ...rest
} = Astro.props as Props;

// todo: put to site.config.ts as global object
const externalLink = {
  newTab: false,
  cursorType: "",
  showNewTabIcon: false,
};

const openInNewTab = external || (external && externalLink.newTab);
const targetAttr = openInNewTab ? "_blank" : undefined;

const relParts = [openInNewTab && "noopener noreferrer", rel]
  .filter(Boolean)
  .join(" ");
const relAttr = relParts || undefined;

const ariaLabel = openInNewTab
  ? title
    ? `${title}, opens in new tab`
    : undefined
  : title || undefined;

const showCursor
  = openInNewTab
    && externalLink.cursorType
    && externalLink.cursorType !== "pointer";

const showIcon = openInNewTab || externalLink.showNewTabIcon;

let umamiEventName: string | undefined;
if (umami) {
  umamiEventName = umami;
}
else if (openInNewTab && href) {
  try {
    umamiEventName = `External: ${new URL(href).hostname.replace(/^www\./, "")}`;
  }
  catch {
    umamiEventName = "External link click";
  }
}
const umamiEventURL = openInNewTab ? href : undefined;
---

<a
  class:list={[
    "op-60 no-underline hover:op-100",
    { "external-link-cursor": showCursor },
    className,
  ]}
  {href}
  {title}
  aria-label={ariaLabel}
  rel={relAttr}
  target={targetAttr}
  data-umami-event={umamiEventName}
  data-umami-event-url={umamiEventURL}
  {...rest}
>
  {
    Astro.slots.has("default") && (
      <>
        <slot />{showIcon && (
          <>
            <span
              i-ph-arrow-up-right
              aria-hidden="true"
            />{!title && <span class="sr-only">, opens in new tab</span>}
          </>
        )}
      </>
    )
  }{
    Astro.slots.has("title") && (
      <span class="text-lg leading-1.3em align-middle">
        <slot name="title" />
        {showIcon && (
          <>
            <span
              i-ph-arrow-up-right
              aria-hidden="true"
            />{!title && <span class="sr-only">, opens in new tab</span>}
          </>
        )}
      </span>
    )
  }<slot name="end" /></a
>
