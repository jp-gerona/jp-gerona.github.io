---

---
<section
  class="section-container px-6 py-20 flex min-h-[100svh] items-center justify-center relative overflow-hidden md:px-10"
>
  <div class="hero-content mx-auto text-center flex flex-col gap-5 max-w-3xl items-center">
    <p class="text-[0.75rem] tracking-[0.2em] op-70 uppercase md:text-[0.85rem]">
      Hero Placeholder
    </p>

    <h1 class="text-4xl leading-[1.05] tracking-[-0.02em] md:text-6xl">
      Web Portfolio
    </h1>

    <p class="text-sm leading-relaxed op-70 max-w-2xl md:text-base">
      Hero Section.
    </p>
  </div>

  <div
    class="hero-img rounded-full bg-zinc-500/25 op-30 h-[26rem] w-[26rem] pointer-events-none absolute blur-3xl dark:bg-zinc-100/15"
    aria-hidden="true"
  ></div>
</section>

<script>
  import gsap from "gsap";

  const HERO_TARGETS = ["nav", ".hero-img", ".hero-content"];

  let heroTimeline: gsap.core.Timeline | null = null;

  function setupHeroTimeline() {
    heroTimeline?.kill();

    gsap.set(HERO_TARGETS, {
      y: "35svh",
    });

    heroTimeline = gsap.timeline({ paused: true });
    heroTimeline.to(HERO_TARGETS, {
      y: "0%",
      duration: 1.25,
      ease: "power3.out",
    });
  }

  function playHeroTimeline() {
    if (!heroTimeline) {
      setupHeroTimeline();
    }

    heroTimeline?.play(0);
  }

  document.addEventListener("astro:page-load", () => {
    setupHeroTimeline();

    if ((window as Window & { __jpPreloaderDone?: boolean }).__jpPreloaderDone) {
      playHeroTimeline();
    }
  });

  window.addEventListener("preloaderExitStart", () => {
    playHeroTimeline();
  });
</script>
