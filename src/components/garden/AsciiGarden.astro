---

<div class="row-span-3 col-start-2 row-start-2 self-stretch justify-self-stretch relative overflow-hidden md:col-span-full md:row-span-1 md:col-start-1 md:row-start-2">
  <canvas id="ascii-garden" class="h-full w-full block" aria-hidden="true"></canvas>
</div>

<script>
import type { Plant } from "@/types";
import { plants } from "@/components/garden/growPlants";

const CHAR_W = 7.2;
const CHAR_H = 15;
const FONT_SIZE = 12;
const FONT = `${FONT_SIZE}px "IBM Plex Mono", monospace`;

interface PlacedPlant {
  plant: Plant;
  col: number;
  row: number;
}

function pickRandomPlant(): Plant {
  const total = plants.reduce((s, p) => s + p.weight, 0);
  let r = Math.random() * total;
  for (const { factory, weight } of plants) {
    r -= weight;
    if (r <= 0)
      return factory();
  }
  return plants[0].factory();
}

function initGarden() {
  const canvas = document.getElementById("ascii-garden") as HTMLCanvasElement;
  if (!canvas)
    return;

  const ctx = canvas.getContext("2d")!;
  const wrapper = canvas.parentElement!;

  let placed: PlacedPlant[] = [];
  let currentDpr = window.devicePixelRatio || 1;

  function resize() {
    currentDpr = window.devicePixelRatio || 1;
    const rect = wrapper.getBoundingClientRect();
    canvas.width = Math.round(rect.width * currentDpr);
    canvas.height = Math.round(rect.height * currentDpr);
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;
    ctx.setTransform(currentDpr, 0, 0, currentDpr, 0, 0);
    populate(rect.width, rect.height);
  }

  function populate(w: number, h: number) {
    placed = [];
    const gridCols = Math.floor(w / CHAR_W);
    const gridRows = Math.floor(h / CHAR_H);

    const cellW = 14;
    const cellH = 5;
    const halfCell = Math.floor(cellW / 2);

    let rowIndex = 0;
    for (let row = 1; row < gridRows - 4; row += cellH) {
      const stagger = rowIndex % 2 === 1 ? halfCell : 0;

      for (let col = 2 + stagger; col < gridCols - 6; col += cellW) {
        if (Math.random() < 0.15)
          continue;

        const jitterCol = col + Math.floor(Math.random() * 5) - 2;
        const jitterRow = row + Math.floor(Math.random() * 3) - 1;

        const c = Math.max(1, Math.min(jitterCol, gridCols - 6));
        const r = Math.max(1, Math.min(jitterRow, gridRows - 4));

        placed.push({
          plant: pickRandomPlant(),
          col: c,
          row: r,
        });
      }

      rowIndex++;
    }
  }

  resize();
  window.addEventListener("resize", resize);

  ctx.font = FONT;
  ctx.textBaseline = "top";

  function draw() {
    const dpr = window.devicePixelRatio || 1;
    if (dpr !== currentDpr)
      resize();

    const rect = wrapper.getBoundingClientRect();
    ctx.clearRect(0, 0, rect.width, rect.height);

    const now = Date.now();

    for (const { plant, col, row } of placed) {
      plant.update(now);
      const lines = plant.getLines();
      const colors = plant.getColors();

      for (let i = 0; i < lines.length; i++) {
        ctx.fillStyle = colors[i] || colors[0];
        ctx.font = FONT;
        ctx.fillText(lines[i], col * CHAR_W, (row + i) * CHAR_H);
      }
    }

    requestAnimationFrame(draw);
  }

  draw();
}

if (document.readyState === "complete") {
  initGarden();
}
else {
  window.addEventListener("load", initGarden);
}
</script>
