---
const info: [string, string][] = [
  ["OS", "macOS Monterey 12.7.6 x86_64"],
  ["Host", "MacBook Air (13-inch, Early 2015)"],
  ["Kernel", "Darwin 21.6.0"],
  ["Shell", "zsh 5.8.1"],
  ["WM", "Quartz Compositor"],
  ["Terminal", "WezTerm"],
  ["Term Font", "JetBrains Mono"],
  ["CPU", "Intel i5-5350U (4) @ 1.80GHz"],
  ["GPU", "Intel HD Graphics 6000"],
  ["Locale", "en_US.UTF-8"],
];

const palette = [
  "bg-mocha-surface1",
  "bg-mocha-red",
  "bg-mocha-green",
  "bg-mocha-yellow",
  "bg-mocha-blue",
  "bg-mocha-pink",
  "bg-mocha-teal",
  "bg-mocha-lavender",
];
---

<div class="text-mocha-text p-6 rounded-lg bg-mocha-base overflow-x-auto md:p-8">
  <div class="text-xs leading-snug font-mono flex flex-col gap-6 md:flex-row md:gap-8 md:items-start">
    <pre
      aria-hidden="true"
      class="leading-tight m-0 shrink-0 select-none"
    ><span class="text-mocha-green">                    'c.
                 ,xNMM.
               .OMMMMo
               OMMM0,
</span><span class="text-mocha-yellow">     .;loddo:' loolloddol;.
   cKMMMMMMMMMMNWMMMMMMMMMM0:
</span><span class="text-mocha-peach"> .KMMMMMMMMMMMMMMMMMMMMMMMWd.
 XMMMMMMMMMMMMMMMMMMMMMMMX.
;MMMMMMMMMMMMMMMMMMMMMMMM:
</span><span class="text-mocha-red">:MMMMMMMMMMMMMMMMMMMMMMMM:
.MMMMMMMMMMMMMMMMMMMMMMMMX.
</span><span class="text-mocha-mauve"> kMMMMMMMMMMMMMMMMMMMMMMMMWd.
 .XMMMMMMMMMMMMMMMMMMMMMMMMMMk
  .XMMMMMMMMMMMMMMMMMMMMMMMMK.
</span><span class="text-mocha-blue">    kMMMMMMMMMMMMMMMMMMMMMMd
     ;KMMMMMMMWXXWMMMMMMMk.
       .cooc,.    .,coo:.</span></pre>

    <div class="flex flex-col gap-1">
      <div>
        <span class="text-mocha-green font-semibold">JP</span><span class="text-mocha-text">@</span><span class="text-mocha-green font-semibold">theas-air</span>
      </div>
      <div class="text-mocha-overlay1">------------</div>

      {info.map(([key, value]) => (
        <div>
          <span class="text-mocha-blue font-semibold">{key}:</span>{" "}
          <span class="text-mocha-subtext1">{value}</span>
        </div>
      ))}

      <div aria-hidden="true" class="mt-3 flex">
        {palette.map(color => <span class={`h-4 w-4 ${color}`} />)}
      </div>
    </div>
  </div>
</div>
