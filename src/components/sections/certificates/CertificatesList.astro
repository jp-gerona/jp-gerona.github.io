---
import { Image } from "astro:assets";
import advancedPython from "@/assets/certificates/advanced-python-reconnaissance.jpg";
import workImmersion from "@/assets/certificates/best-in-work-immersion-stem.jpg";
import ccna from "@/assets/certificates/ccna-introduction-to-networks.jpg";
import comptiaTechPlus from "@/assets/certificates/comptia-tech-plus.jpg";
import cybersocMembership from "@/assets/certificates/cybersocph-membership.jpg";
import ethicalHacker from "@/assets/certificates/ethical-hacker.jpg";
import fullStackWebDev from "@/assets/certificates/full-stack-web-development.jpg";
import Link from "@/components/base/Link.astro";

const certificates = [
  {
    image: advancedPython,
    title: "Advanced Python - Reconnaissance",
    issuer: "Infosec",
    date: "July 2026",
    verifyUrl: "https://coursera.org/verify/FL00W9MV5BOM",
  },
  {
    image: fullStackWebDev,
    title: "Full Stack Web Development",
    issuer: "Amazon",
    date: "July 2026",
    verifyUrl: "https://coursera.org/verify/LSAYE1UFUTZY",
  },
  {
    image: cybersocMembership,
    title: "Certificate of Membership",
    issuer: "CyberSocPH",
    date: "June 2026",
  },
  {
    image: comptiaTechPlus,
    title: "CompTIA Tech+",
    issuer: "CompTIA",
    date: "December 2025",
  },
  {
    image: ccna,
    title: "CCNA: Introduction to Networks",
    issuer: "Cisco Networking Academy",
    date: "September 2025",
  },
  {
    image: ethicalHacker,
    title: "Ethical Hacker",
    issuer: "Cisco Networking Academy",
    date: "March 2025",
  },
  {
    image: workImmersion,
    title: "Best in Work Immersion - STEM",
    issuer: "Creotec Philippines",
    date: "April 2021",
  },
];

const firstYear = certificates[certificates.length - 1].date.split(" ")[1];
---

<section class="min-h-svh">
  <div class="flex flex-col gap-4.5">
    <p class="text-sm color-portfolio-muted leading-snug max-w-prose">
      These are my microcredentials for upskilling:
      {certificates.length} certificates earned since {firstYear}. The ones
      verifiable online link to their verification pages.
    </p>
    <ul class="gap-4.5 grid grid-cols-1 sm:grid-cols-2">
      {certificates.map((cert) => {
        const card = (
          <>
            <Image
              src={cert.image}
              alt={`${cert.title} certificate from ${cert.issuer}`}
              class="rounded-lg h-auto w-full aspect-4/3 object-cover"
              loading="lazy"
              widths={[480, 800, 1200]}
              sizes="(min-width: 640px) 50vw, 100vw"
            />
            <div class="flex flex-col gap-0.5">
              <h2 class="text-[1.125rem] leading-tight font-400 font-serif">{cert.title}</h2>
              <p class="text-sm color-portfolio-muted leading-snug">{`${cert.issuer}, ${cert.date}`}</p>
            </div>
          </>
        );

        return (
          <li>
            {cert.verifyUrl
              ? (
                  <Link
                    class="flex flex-col gap-1"
                    href={cert.verifyUrl}
                    title={`Verify ${cert.title}`}
                    external
                  >
                    {card}
                  </Link>
                )
              : <div class="flex flex-col gap-1">{card}</div>}
          </li>
        );
      })}
    </ul>
    <p class="text-sm color-portfolio-muted leading-snug">
      For badges not listed here,
      {" "}
      <Link
        class="color-portfolio-ink underline underline-offset-4"
        href="https://www.credly.com/users/julian-peter-gerona/badges"
        title="Credly profile"
        external
      >
        visit my Credly page
      </Link>.
    </p>
  </div>
</section>

