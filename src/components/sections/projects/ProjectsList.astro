---
import { getCollection } from "astro:content";
import { env } from "@/utils/env";

const projects = (
  await getCollection("projects", ({ data }) => !env.isProd || !data.draft)
).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);

const aspects = ["aspect-4/3", "aspect-square", "aspect-3/4"];
---

<section class="min-h-svh">
  <div class="flex flex-col gap-4.5">
    <h1 class="text-3xl leading-tight tracking-tight font-600">
      Projects
    </h1>
    <div class="flex flex-col gap-4.5 sm:flex-row" data-masonry>
      <ul class="flex flex-1 flex-col gap-4.5" data-masonry-column>
        {projects.map((project, i) => {
          const monthYear = project.data.pubDate?.toLocaleDateString("en-US", { month: "long", year: "numeric" });
          const meta = [project.data.category, monthYear].filter(Boolean).join(" - ");

          return (
            <li data-masonry-item={i}>
              <a
                href={`/projects/${project.id}/`}
                class="focus-ring-link group flex flex-col gap-1"
              >
                {project.data.cover
                  ? (
                      <img
                        src={project.data.cover}
                        alt=""
                        class={`rounded-lg w-full object-cover ${aspects[i % aspects.length]}`}
                        loading="lazy"
                      />
                    )
                  : (
                      <div class={`rounded-lg bg-portfolio-fill w-full ${aspects[i % aspects.length]}`} />
                    )}
                <div class="flex flex-col gap-1">
                  {meta && (
                    <p class="text-[0.8125rem] color-portfolio-faint font-mono uppercase">{meta}</p>
                  )}
                  <h2 class="text-[1.5rem] leading-tight font-400 font-serif group-hover:underline group-hover:underline-offset-4">{project.data.title}</h2>
                  {project.data.description && (
                    <p class="text-sm color-portfolio-muted leading-snug">{project.data.description}</p>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
      <ul class="flex flex-1 flex-col gap-4.5 empty:hidden" data-masonry-column></ul>
    </div>
  </div>
</section>

<script>
  function initProjectsMasonry() {
    const root = document.querySelector<HTMLElement>("[data-masonry]");
    if (!root)
      return;

    const columns = [...root.querySelectorAll<HTMLElement>("[data-masonry-column]")];
    if (columns.length < 2)
      return;

    const items = [...root.querySelectorAll<HTMLElement>("[data-masonry-item]")].sort(
      (a, b) => Number(a.dataset.masonryItem) - Number(b.dataset.masonryItem),
    );

    const wide = window.matchMedia("(min-width: 640px)");

    function layout() {
      items.forEach((item, i) => {
        const target = wide.matches ? columns[i % columns.length] : columns[0];
        target.appendChild(item);
      });
    }

    layout();
    wide.addEventListener("change", layout);
  }

  document.addEventListener("astro:page-load", initProjectsMasonry);
</script>
