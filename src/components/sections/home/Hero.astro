---

---
<section
  data-home-hero
  class="section-container px-6 py-20 flex items-center justify-center relative overflow-hidden min-h-svh md:px-10"
>
  <div class="hero-content mx-auto text-center flex flex-col gap-5 max-w-3xl items-center">
    <p class="text-[0.75rem] tracking-[0.2em] op-70 uppercase md:text-[0.85rem]">
      Hero Placeholder
    </p>

    <h1 class="text-4xl leading-[1.05] tracking-[-0.02em] md:text-6xl">
      Web Portfolio
    </h1>

    <p class="text-sm leading-relaxed op-70 max-w-2xl md:text-base">
      Hero Section.
    </p>
  </div>

  <div
    class="hero-img rounded-full bg-zinc-500/25 op-30 h-[26rem] w-[26rem] pointer-events-none absolute blur-3xl dark:bg-zinc-100/15"
    aria-hidden="true"
  ></div>
</section>

<script>
  import gsap from "gsap";

  const HERO_SECTION_SELECTOR = "[data-home-hero]";
  const HERO_TARGETS = [
    "[data-preloader-transition-nav]",
    "[data-preloader-transition-dirbar]",
    ".hero-img",
    ".hero-content",
  ];

  type WindowWithHeroTransition = Window & {
    heroPreloaderExitHandlerBound?: boolean;
  };

  let heroTimeline: gsap.core.Timeline | null = null;

  function setupHeroTimeline() {
    heroTimeline?.kill();

    if (!document.querySelector(HERO_SECTION_SELECTOR)) {
      heroTimeline = null;
      return;
    }

    const targets = gsap.utils.toArray<HTMLElement>(HERO_TARGETS.join(","));

    if (!targets.length) {
      heroTimeline = null;
      return;
    }

    gsap.set(targets, {
      y: "35svh",
    });

    heroTimeline = gsap.timeline({ paused: true });
    heroTimeline.to(targets, {
      y: "0%",
      duration: 1.25,
      ease: "power3.out",
      overwrite: "auto",
    });
  }

  function playHeroTimeline() {
    if (!heroTimeline) {
      setupHeroTimeline();
    }

    heroTimeline?.play(0);
  }

  function handlePreloaderExitStart() {
    playHeroTimeline();
  }

  const windowWithHeroTransition = window as WindowWithHeroTransition;

  if (!windowWithHeroTransition.heroPreloaderExitHandlerBound) {
    window.addEventListener("preloaderExitStart", handlePreloaderExitStart);
    windowWithHeroTransition.heroPreloaderExitHandlerBound = true;
  }
</script>
