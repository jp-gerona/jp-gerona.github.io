---
import { getCollection } from "astro:content";
import Link from "@/components/base/Link.astro";
import ContributionGraph from "@/components/widgets/ContributionGraph.astro";
import { certificates } from "@/data/certificates";
import { siteConfig } from "@/site.config";
import { env } from "@/utils/env";
import { fetchContributions } from "@/utils/githubContributions";

const year = "2026";
const calendar = await fetchContributions(siteConfig.user, `${year}-01-01`, `${year}-12-31`);

const recentProjects = (
  await getCollection("projects", ({ data }) => !env.isProd || !data.draft)
)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .slice(0, 3);

const recentCertificates = certificates.slice(0, 3);

const sectionLabel = "text-[0.6875rem] color-portfolio-faint tracking-wide font-mono uppercase";
---

<section aria-label="Introduction" class="flex flex-col gap-16">
  <div class="flex flex-col gap-4.5">
    <h1 class="text-4xl leading-tight font-400 font-serif max-w-[34rem] md:text-[2.75rem]">
      I engineer <mark class="color-portfolio-accent px-1 bg-portfolio-accent-soft">solutions</mark>, with AI as the tool and <em>craft</em> as the standard.
    </h1>
    <p class="color-portfolio-muted leading-relaxed max-w-prose">
      I'm JP, a 4th year Information Technology student at Mapúa Malayan
      Colleges Laguna. I design, architect, and ship web and mobile software,
      and I use AI in the workflow with my engineering judgment guiding it.
    </p>
    <p class="color-portfolio-muted leading-relaxed max-w-prose">
      Quality is the one thing I don't trade. Kaizen keeps the rest moving:
      small, continuous improvements to my skills and to the things I ship.
    </p>
  </div>

  <div>
    <h2 class={sectionLabel}>Work experience</h2>
    <ul class="mt-4.5 flex flex-col gap-6">
      <li class="flex gap-3.5 items-start">
        <img src="/assets/logos/binan.png" alt="Seal of the City of Biñan" width="40" height="40" class="shrink-0 size-10 object-contain" loading="lazy" />
        <div class="flex flex-col gap-0.5">
          <Link class="text-[1.125rem] leading-tight font-serif underline-offset-4 hover:underline" href="/practicum" title="IT Practicum">
            City Government of Biñan
          </Link>
          <span class="text-sm color-portfolio-muted leading-snug">
            IT Practicum, ICTO Software Development and Creative Support team · April to July 2026
          </span>
          <span class="text-sm color-portfolio-muted leading-snug">
            Lead developer of the Biñan Access Card MIS; proposed and built Eskwelabs.
          </span>
        </div>
      </li>
      <li class="flex gap-3.5 items-start">
        <img src="/assets/logos/creotec.png" alt="Creotec Philippines, Inc. logo" width="161" height="30" class="mt-1 shrink-0 h-7.5 w-auto object-contain" loading="lazy" />
        <div class="flex flex-col gap-0.5">
          <span class="text-[1.125rem] leading-tight font-serif">Creotec Philippines, Inc.</span>
          <span class="text-sm color-portfolio-muted leading-snug">
            Student Trainee, work immersion · April 2019
          </span>
          <span class="text-sm color-portfolio-muted leading-snug">
            80 hours of mobile application development; awarded Best in Work Immersion for the STEM strand.
          </span>
        </div>
      </li>
    </ul>
  </div>

  <div>
    <h2 class={sectionLabel}>Recent projects</h2>
    <ul class="mt-4.5 flex flex-col gap-4.5">
      {recentProjects.map(project => (
        <li>
          <Link class="group flex flex-col gap-0.5" href={`/projects/${project.id}/`} title={project.data.title}>
            <span class="text-[1.125rem] leading-tight font-serif underline-offset-4 group-hover:underline">
              {project.data.title}
            </span>
            <span class="text-sm color-portfolio-muted leading-snug">
              {project.data.description}
            </span>
          </Link>
        </li>
      ))}
    </ul>
    <Link class="text-sm color-portfolio-muted mt-4.5 transition-colors duration-200 hover:color-portfolio-ink" href="/projects">
      All projects →
    </Link>
  </div>

  <div>
    <h2 class={sectionLabel}>Recent certificates</h2>
    <ul class="mt-4.5 flex flex-col gap-4.5">
      {recentCertificates.map(cert => (
        <li class="flex flex-col gap-0.5">
          {cert.verifyUrl
            ? (
                <Link class="text-[1.125rem] leading-tight font-serif underline-offset-4 hover:underline" href={cert.verifyUrl} title={`Verify ${cert.title}`} external>
                  {cert.title}
                </Link>
              )
            : <span class="text-[1.125rem] leading-tight font-serif">{cert.title}</span>}
          <span class="text-sm color-portfolio-muted leading-snug">{`${cert.issuer}, ${cert.date}`}</span>
        </li>
      ))}
    </ul>
    <Link class="text-sm color-portfolio-muted mt-4.5 transition-colors duration-200 hover:color-portfolio-ink" href="/certificates">
      All certificates →
    </Link>
  </div>

  <div>
    <h2 class={sectionLabel}>Education</h2>
    <div class="mt-4.5 flex flex-col gap-0.5">
      <p class="text-[1.125rem] leading-tight font-serif">Mapúa Malayan Colleges Laguna</p>
      <p class="text-sm color-portfolio-muted leading-snug">
        B.S. Information Technology, specializing in Cybersecurity · 2022–2026
      </p>
      <p class="text-sm color-portfolio-muted leading-snug">
        4th year, graduating. Dean's Lister all four years, President's Lister for one.
      </p>
    </div>
  </div>

  <div>
    <h2 class={sectionLabel}>GitHub activity</h2>
    <div class="mt-4.5">
      {calendar
        ? <ContributionGraph calendar={calendar} year={year} />
        : <p class="text-xs color-portfolio-faint">GitHub activity unavailable right now.</p>}
    </div>
  </div>
</section>
