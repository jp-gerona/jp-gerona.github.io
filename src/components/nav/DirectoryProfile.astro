---
import { getEntry } from "astro:content";
import Link from "@/components/base/Link.astro";
import { siteConfig } from "@/site.config";

const entry = await getEntry("resume", "resume");
if (!entry) {
  throw new Error("Missing resume content entry at src/content/resume/resume.yaml");
}
const email = entry.data.contact.find(contact => contact.href?.startsWith("mailto:"));
---

<div>
  <Link
    class="text-[2.5rem] color-portfolio-ink tracking-tight font-serif"
    href="/"
    title={`${siteConfig.title} @ ${siteConfig.hostname}`}
  >
    {siteConfig.user}
  </Link>
  <p class="text-sm color-portfolio-muted mt-1">{entry.data.role}</p>
  {email && (
    <Link href={email.href} class="text-sm color-portfolio-muted mt-3 decoration-current underline-offset-4 hover:color-portfolio-ink underline! decoration-dashed!">{email.text}</Link>
  )}
  <nav class="mt-4 flex gap-3 items-center" aria-label="Profile links">
    {siteConfig.socials.map(social => (
      <Link
        class="color-portfolio-muted flex transition-colors duration-200 hover:color-portfolio-ink"
        href={social.href}
        title={`${social.label} @ ${siteConfig.user}`}
        external
      >
        <span class={`${social.icon} text-xl block`} aria-hidden="true" />
      </Link>
    ))}
    <Link class="color-portfolio-muted flex hover:color-portfolio-ink" href="/" title="Portfolio">
      <span class="i-ri-global-line text-xl block" aria-hidden="true" />
    </Link>
  </nav>
</div>
