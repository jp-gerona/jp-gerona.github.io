---
import type { MarkdownHeading } from "astro";
import Link from "@/components/base/Link.astro";
import { siteConfig } from "@/site.config";

interface Props {
  headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const tocItems = headings.filter(heading => heading.depth === 2);

function normalizePath(pathname: string): string {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePath(Astro.url.pathname);
const navItems = [
  { label: "Home", href: "/" },
  ...siteConfig.navigation.main,
];
---

<header>
  <div class="lg:top-12 lg:sticky">
    <Link
      class="text-[2.5rem] color-portfolio-ink tracking-tight font-serif"
      href="/"
      title={`${siteConfig.title} @ jp-gerona.github.io`}
    >
      jp-gerona
    </Link>

    <nav class="mt-4.5 lg:mt-12" aria-label="Main">
      <ul class="flex flex-wrap gap-1 lg:flex-col lg:items-stretch">
        {
          navItems.map((item) => {
            const isCurrent = normalizePath(item.href) === currentPathname;

            return (
              <li>
                <Link
                  class:list={[
                    "text-sm rounded-lg flex px-3 py-2 transition-colors duration-200",
                    isCurrent
                      ? "color-portfolio-ink bg-portfolio-fill"
                      : "color-portfolio-muted hover:color-portfolio-ink",
                  ]}
                  href={item.href}
                  title={item.title ?? item.label}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {item.label}
                </Link>
              </li>
            );
          })
        }
      </ul>
    </nav>

    {tocItems.length > 0 && (
      <nav class="mt-4.5 pt-4.5 border-t border-portfolio-line hidden lg:block" aria-label="On this page">
        <ul class="flex flex-col">
          {tocItems.map(heading => (
            <li>
              <Link
                class="text-[0.6875rem] color-portfolio-faint tracking-wide font-mono px-3 py-1.5 rounded-lg flex uppercase transition-colors duration-200 hover:color-portfolio-ink"
                href={`#${heading.slug}`}
                data-toc-link
              >
                {heading.text}
              </Link>
            </li>
          ))}
        </ul>
        <Link
          class="text-sm color-portfolio-muted mt-4.5 px-3 py-2 rounded-lg flex transition-colors duration-200 hover:color-portfolio-ink"
          href="/projects"
        >
          Back to projects
        </Link>
      </nav>
    )}
  </div>
</header>

<script>
  import { scrollToElement } from "@/utils/smoothScroll";

  let observer: IntersectionObserver | null = null;

  function initToc() {
    observer?.disconnect();

    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    if (links.length === 0) {
      return;
    }

    const linkForTarget = new Map<Element, HTMLAnchorElement>();
    const targets: Element[] = [];

    for (const link of links) {
      const id = decodeURIComponent(link.hash.slice(1));
      const target = document.getElementById(id);
      if (!target) {
        continue;
      }

      linkForTarget.set(target, link);
      targets.push(target);

      link.addEventListener("click", (event) => {
        event.preventDefault();
        scrollToElement(target);
        history.replaceState(null, "", link.hash);
      });
    }

    let active: HTMLAnchorElement | null = null;
    function setActive(link: HTMLAnchorElement) {
      if (active === link) {
        return;
      }
      active?.classList.replace("color-portfolio-ink", "color-portfolio-faint");
      link.classList.replace("color-portfolio-faint", "color-portfolio-ink");
      active = link;
    }

    const visible = new Set<Element>();
    observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          visible.add(entry.target);
        }
        else {
          visible.delete(entry.target);
        }
      }

      const current = targets.find(target => visible.has(target));
      if (current) {
        setActive(linkForTarget.get(current)!);
      }
    }, { rootMargin: "0px 0px -80% 0px" });

    for (const target of targets) {
      observer.observe(target);
    }
  }

  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
</script>
