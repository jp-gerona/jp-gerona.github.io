---
import Link from "@/components/base/Link.astro";
import { siteConfig } from "@/site.config";

function normalizePath(pathname: string): string {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePath(Astro.url.pathname);
const navItems = siteConfig.navigation.main;
---

<header class="p-4 flex items-center top-0 justify-between sticky z-40">
  <Link class="text-[0.8rem] font-500 font-mono uppercase" href="/" title="Julian Peter Gerona @ jp-gerona.github.io">{siteConfig.title}</Link>
  <nav aria-label="Primary">
    <ul class="text-[0.6rem] text-white font-500 font-mono p-0.75 list-none rounded-md bg-black/80 flex uppercase items-center justify-center backdrop-blur-md">
      {
        navItems.map((item) => {
          const isCurrent = !item.external && normalizePath(item.href) === currentPathname;
          const linkClass = ["px-4 py-2", item.className].filter(Boolean).join(" ");

          return (
            <li>
              <Link
                data-navbar-link
                class={linkClass}
                href={item.href}
                title={item.title ?? item.label}
                external={item.external}
                rel={item.rel}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </Link>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
