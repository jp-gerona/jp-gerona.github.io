---
import Link from "@/components/base/Link.astro";
import { siteConfig } from "@/site.config";

function normalizePath(pathname: string): string {
  if (pathname !== "/" && pathname.endsWith("/")) {
    return pathname.slice(0, -1);
  }

  return pathname;
}

const currentPathname = normalizePath(Astro.url.pathname);
const navItems = siteConfig.navigation.main;
---
<header class="border-bd p-4 border-b border-portfolio-black bg-portfolio-white flex h-[57px] w-full items-center top-0 justify-between fixed z-40">
  <Link
    class="text-[0.7rem] color-portfolio-black leading-none tracking-tight font-500 font-mono shrink-0 uppercase"
    href="/"
    title={`${siteConfig.title} @ jp-gerona.github.io`}
  >
    {siteConfig.title}
  </Link>

  <nav>
    <ul class="flex gap-6 items-center justify-center">
      {
        navItems.map((item) => {
          const isCurrent = !item.external && normalizePath(item.href) === currentPathname;

          return (
            <li class="align-middle flex items-center">
              <Link
                class="text-[0.7rem] color-portfolio-black leading-none tracking-tight font-500 font-mono shrink-0 uppercase"
                href={item.href}
                title={item.title ?? item.label}
                external={item.external}
                rel={item.rel}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </Link>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
